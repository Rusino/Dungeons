{
  "version": "1.0.0",
  "pipeline": "The Gauntlet",
  "restrictions": {
    "disallowed_write_patterns": [
      ".antigravity/**",
      "traps/**",
      "src/CMakeLists.txt",
      "tests/baseline/**",
      ".git/**",
      "*.sh"
    ],
    "agent_permissions": {
      "The_Architect": {
        "allowed_write_patterns": [
          "src/engine/*.hpp"
        ],
        "allowed_read_patterns": [
          "docs/rfcs/**",
          "src/engine/**"
        ]
      },
      "The_Artificer": {
        "allowed_write_patterns": [
          "src/engine/*.cpp"
        ],
        "allowed_read_patterns": [
          "src/engine/**",
          "docs/rfcs/**"
        ],
        "disallowed_code_constructs": [
          "#pragma",
          "reinterpret_cast",
          "goto",
          "malloc",
          "free"
        ]
      },
      "The_Trapsmith": {
        "allowed_write_patterns": [
          "tests/autogenerated/*.cpp"
        ],
        "allowed_read_patterns": [
          "src/engine/*.hpp",
          "docs/rfcs/**"
        ]
      },
      "The_Scavenger": {
        "allowed_write_patterns": [],
        "allowed_read_patterns": [
          "**"
        ],
        "spdx_whitelist": [
          "Apache-2.0",
          "MIT",
          "BSD-3-Clause",
          "BSD-2-Clause",
          "Unicode-DFS-2016"
        ]
      }
    },
    "execution_constraints": {
      "max_retries": 5,
      "mutation_score_threshold": 90.0,
      "max_heap_allocations_per_glyph": 0,
      "strict_cxx_standard": "c++20"
    }
  }
}
